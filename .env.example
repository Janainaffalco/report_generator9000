# Copy this file to .env for local development. In a VPS, inject these
# variables with the process manager or container runtime instead.
#
# Create the key in Google AI Studio. Never commit a real key.

# Stable production model. Avoid preview, experimental, and *-latest aliases.
GEMINI_MODEL=gemini-3.5-flash

# Used only when the primary returns 503 UNAVAILABLE (overloaded).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# The response includes two short paragraphs plus exact grounding citations.
GEMINI_OUTPUT_BUDGET=1024

# Network controls for unattended VPS execution.
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=3
